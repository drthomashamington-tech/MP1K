\chapter{قانون برگزاری مناقصات و تضامین}

\section{کلیات و دامنه شمول}

\textbf{قانون برگزاری مناقصات} (مصوب ۱۳۸۳) چارچوب انتخاب پیمانکار و تأمین‌کننده در دستگاه‌های مشمول را تعیین می‌کند.

\textbf{دامنه شمول (ماده ۱):} وزارتخانه‌ها، مؤسسات دولتی، شرکت‌های دولتی، نهادهای عمومی غیردولتی، بنیادها، شهرداری‌ها.

\textbf{اصل حاکم:} شفافیت، رقابت، عدم تبعیض و صرفه و صلاح.

\section{تعاریف کلیدی}
\begin{description}[leftmargin=*]
\item[مناقصه:] فرآیند دعوت از متقاضیان برای ارائه پیشنهاد و انتخاب بهترین پیشنهاد.
  \item[مناقصه‌گزار:] دستگاه اجرایی که مناقصه را برگزار می‌کند.
  \item[مناقصه‌گر:] شخص حقیقی یا حقوقی که پیشنهاد ارائه می‌دهد.
  \item[کمیسیون مناقصه:] مرجع تصمیم‌گیری در فرآیند مناقصه.
  \item[کمیته فنی بازرگانی:] مرجع ارزیابی کیفی پیشنهادها.
\end{description}

\section{انواع روش‌های برگزاری مناقصه}

\subsection{مناقصه عمومی (ماده ۲۰)}
دعوت از همه متقاضیان با انتشار آگهی در روزنامه کثیرالانتشار و پایگاه اطلاع‌رسانی. \textbf{مهلت:} حداقل ۱۰ روز از انتشار تا فروش اسناد و ۱۰ روز از فروش تا تحویل پیشنهاد.

\subsection{مناقصه محدود (ماده ۲۳)}
دعوت از فهرست محدودی از پیمانکاران. \textbf{شرایط:} محرمانگی، فوریت، محدود بودن تعداد واجدین شرایط، تخصصی بودن. حداقل ۵ نفر.

\subsection{ترک تشریفات مناقصه (ماده ۲۷)}
هرگاه انجام مناقصه بر اساس \textbf{گزارش توجیهی} ممکن نباشد، با تشخیص \textbf{هیأت سه‌نفره موضوع ماده ۲۸}، معامله به طریق دیگر انجام می‌شود.

\textbf{موارد کاربرد:} فوریت غیرقابل پیش‌بینی، انحصاری بودن، تأمین از منبع واحد، تمدید قرارداد موجود، خرید قطعات یدکی اصلی.

\section{ماده ۲۸ — ترکیب هیأت ترک تشریفات}

\begin{description}[leftmargin=*]
  \item[الف) واحدهای مرکزی:] معاون مالی و اداری + ذیحساب + یک کارمند خبره.
  \item[ب) واحدهای استانی:] استاندار یا نماینده + بالاترین مقام اجرایی محل + ذیحساب.
  \item[ج) شرکت‌های دولتی:] مدیرعامل + ذیحساب یا مدیر مالی + یک نفر به انتخاب مجمع.
\end{description}

\textbf{نکات اجرایی:}
\begin{itemize}[leftmargin=*]
  \item هیأت با حضور هر سه عضو رسمیت دارد.
  \item تصمیمات با \textbf{رأی اکثریت}.
  \item صورتجلسه مکتوب و امضاشده در پرونده نگهداری می‌شود.
  \item حداقل \textbf{سه استعلام} از سه فروشنده تهیه شود.
  \item \textbf{ذیحساب} می‌تواند تصمیم را رد کند.
\end{itemize}

\section{ماده ۲۹ — موارد عدم الزام به برگزاری مناقصه}

\begin{description}[leftmargin=*]
  \item[بند الف — منحصربه‌فرد بودن:] خرید اموال یا خدمات انحصاری با تشخیص وزیر. «منحصربه‌فرد» به معنای «تنها تأمین‌کننده» است، نه «بهترین تأمین‌کننده». سوءاستفاده از این بند، رایج‌ترین محل تخلف است.
  \item[بند ب — اموال غیرمنقول:] با تشخیص وزیر و کسب نظر از \textbf{حداقل سه کارشناس رسمی دادگستری}. در صورت نبود کارشناس رسمی، از کارشناسان خبره مورد تأیید دادگستری استفاده می‌شود.
  \item[بند ج — قیمت تعیین‌شده:] خرید با قیمت تعیین‌شده یا کمتر از سوی مراجع قانونی (برق، آب، گاز، داروهای قیمت‌گذاری‌شده).
\end{description}

\textbf{سایر موارد:} خرید سهام، معاملات محرمانه، هزینه‌های ضروری و فوری، خرید خدمات مشاوره (تابع آیین‌نامه انتخاب مشاوران).

\section{کمیته فنی بازرگانی}

\subsection{ترکیب}
نماینده دستگاه (رئیس)، کارشناس فنی، کارشناس بازرگانی، نماینده بهره‌بردار، کارشناس مالی (بدون حق رأی).

\subsection{وظایف}
ارزیابی کیفی، رد پیشنهادهای ناقص با دلیل مکتوب، تعیین امتیاز فنی، اعلام نظر \textbf{مشورتی} به کمیسیون مناقصه. مهلت اعلام نظر: حداکثر ۱۴ روز.

\subsection{نکات کلیدی}
\begin{itemize}[leftmargin=*]
  \item معیارهای ارزیابی باید \textbf{قبل از بازگشایی} در اسناد اعلام شده باشد.
  \item حداقل امتیاز فنی قابل قبول (۶۰-۷۰) باید در اسناد مشخص شود.
  \item اعضا نباید با مناقصه‌گران نسبت خویشاوندی یا منافع مشترک داشته باشند.
\end{itemize}

\section{فرآیند کامل مناقصه دو مرحله‌ای}
انتشار آگهی $\rightarrow$ فروش اسناد $\rightarrow$ تحویل پاکت‌ها (فنی و مالی جدا) $\rightarrow$ بازگشایی پاکت فنی $\rightarrow$ ارزیابی فنی $\rightarrow$ فهرست کوتاه $\rightarrow$ بازگشایی پاکت مالی $\rightarrow$ ارزیابی مالی $\rightarrow$ تعیین برنده $\rightarrow$ انعقاد قرارداد.

\section{انواع تضامین}

\subsection{تضمین شرکت در مناقصه}
\textbf{مبلغ:} ۱٪ تا ۵٪ برآورد (معمولاً ۲٪).
\textbf{شکل:} ضمانت‌نامه بانکی، چک تضمین‌شده، وجه نقد، اوراق مشارکت.
\textbf{اعتبار:} حداقل ۳ ماه و قابل تمدید.
\textbf{استرداد:} پس از انعقاد قرارداد یا اعلام نتیجه.
\textbf{ضبط:} در صورت انصراف برنده یا عدم ارائه تضامین.

\subsection{تضمین انجام تعهدات}
\textbf{مبلغ:} ۵٪ مبلغ اولیه پیمان برای معاملات ساختمانی، ۱۰٪ برای سایر معاملات.
\textbf{زمان اخذ:} پیش از انعقاد قرارداد.
\textbf{آزادسازی:} تا پایان تعهدات نزد کارفرما باقی می‌ماند.
\subsection{تضمین پیش‌پرداخت}
\textbf{مبلغ:} معادل پیش‌پرداخت، حداکثر ۲۵٪ مبلغ معامله.
\textbf{آزادسازی:} تدریجی و در ازای پیشرفت کار.
\textbf{مشاوره:} ۲۰٪ برای مطالعه و طراحی، ۱۰٪ برای دوره ساخت.

\subsection{تضمین حسن انجام کار}
\textbf{مبلغ:} ۱۰٪ از هر پرداخت (صورت‌وضعیت).
\textbf{آزادسازی:} نیمی با تحویل موقت، نیم دیگر پس از تحویل قطعی.
\textbf{مشاوره:} ۱۰٪ از هر پرداخت.

\subsection{انواع ضمانت‌نامه‌های معتبر}
ضمانت‌نامه بانکی، ضمانت‌نامه بیمه‌ای، وجه نقد، سفته با امضای مجاز، وثیقه ملکی (۹۰٪ ارزش کارشناسی)، اوراق مشارکت، سهام بورسی (۷۰٪ ارزش روز)، مطالبات قطعی از دستگاه‌های اجرایی.

\section{تجدید، لغو و شکایات}
\textbf{تجدید (ماده ۱۹):} عدم دریافت ۳ پیشنهاد معتبر، رد تمام پیشنهادها، تغییر شرایط اساسی.
\textbf{لغو:} با دلیل موجه مکتوب.
\textbf{شکایات (ماده ۲۵):} حداکثر ۱۰ روز پس از اعلام نتیجه به دستگاه. پاسخ: حداکثر ۱۵ روز. مرجع بالاتر: سازمان بازرسی، دیوان عدالت اداری.

